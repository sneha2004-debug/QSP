class Pattern32 
{
	public static void main(String[] args) 
	{
		int n=4;
		int a=n*2-1;
		char ch=(char)('a'+(n*2)-1);
		for(int i=1;i<=n;i++)
		{
			for(int j=1;j<=n;j++)
			{
				if(j%2!=0)
				{
					System.out.print(a+" ");
					a--;
				}
				else
				{
					System.out.print(ch+" ");
					ch--;
				}
			}
			System.out.println();
		}
	}
}
