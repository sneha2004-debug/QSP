class Pattern34 
{
	public static void main(String[] args) 
	{
		int n=4;
		char ch=(char)('a'+(n*2)-1);
		for(int i=1;i<=n;i++)
		{
			int a=i;
			for(int j=1;j<=n;j++)
			{
				if(j%2!=0)
				{
					System.out.print(a+" ");
					a+=4;
					
				}
				else
				{
					System.out.print(ch+" ");
				}
			}
			System.out.println();
		}
		
	}
}
