class Pattern37 
{
	public static void main(String[] args) 
	{
		int n=4;
		
		for(int i=1;i<=n;i++)
		{
			int num=i*(n-1);
			for(int j=1;j<=n;j++)
			{
				if(i%2!=0)
				{
					System.out.print(num+" ");
					num--;
				}
				else
				{
					System.out.print(num+" ");
					num++;
				}
			}
			System.out.println();
		}
	}
}
