class Pattern44 
{
	public static void main(String[] args) 
	{
		int n=4;
		int a=1;
		char ch='a';
		for(int i=1;i<=n;i++)
		{
			for(int j=1;j<=n;j++)
			{
				if((i+j)<=n+1)
				{
					System.out.print(a+" ");
				}
				else
				{
					System.out.print(ch+" ");
				}
			}
			System.out.println();
		}
	}
}
