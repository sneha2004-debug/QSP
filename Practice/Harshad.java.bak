// A Harshad number (also called a Niven number) is an integer that is completely divisible by the sum of its individual digits. For example, 18 is a Harshad number because its digits add up to 9 (1 + 8), and 18 is divisible by 9 (\(18 \pmod 9 == 0\))
import java.util.Scanner;
class Harshad
 {
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter a Number :");
		int num=sc.nextInt();
		int temp=num;
		int sum=0;
		if(num<=0)
		{
			System.out.println("Not a harshad number");
		}
		else
		{
				while(num!=0)
				{
					int last=num%10;
					sum=sum+last;
					num/=10;
				}
			if(temp==sum)
			{
				System.out.println("It is a harshad number ");
			}
			else
			{
				System.out.println("It is not a harshad Number");
			}
				
		}
		
	}
}
