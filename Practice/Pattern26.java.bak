class Pattern26 
{
	public static void main(String[] args) 
	{
		int n=4;
		
		for(int i=1;i<=n;i++)
		{
			int a=i;
			for(int j=1;j<=n;j++)
			{
				if(i==1 || j==1)
					System.out.print(a+" ");
				else if(i==n)
					System.out.print((i+1)-j +" ");
				else if(j==n)
					System.out.print((n+1)-i +" ");
				else
					System.out.println("  ");
				a++;
			}
			System.out.println();
		}
	}
}
