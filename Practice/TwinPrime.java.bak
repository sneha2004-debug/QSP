class TwinPrime 
{
	public static void main(String[] args) 
	{
		int n1=11;
		int n2=13;
		boolean flag1=true;
		boolean flag2=true;
		for(int i=2;i<n1;i++)
		{
			if(n1%i==0)
			{
				flag1=false;
				break;
			}
		}
		for(int i=2;i<n2;i++)
		{
			if(n2%i==0)
			{
				flag2=false;
				break;
			}
		}
		if(flag1 && flag2)
		{
			if((n1 - n2) == 2 )
			{
				System.out.println("Twin Prime");
			}
			else
			{
				System.out.println("No Twin Prime");
			}
			
		}
		else
		{
			System.out.println("Not twin prime");
		}
		
	}
}
